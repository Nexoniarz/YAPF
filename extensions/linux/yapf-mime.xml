<?xml version="1.0" encoding="UTF-8"?>
<!-- Registers .yapf files as image/x-yapf (shared-mime-info). -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="image/x-yapf">
    <comment>YAPF image</comment>
    <generic-icon name="image-x-generic"/>
    <magic priority="60">
      <match type="string" value="YAPF" offset="0"/>
    </magic>
    <glob pattern="*.yapf"/>
  </mime-type>
</mime-info>
